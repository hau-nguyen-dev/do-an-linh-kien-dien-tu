# Sao chép file này thành backend/.env (file .env đã nằm trong .gitignore, KHÔNG commit).
# Khi deploy, đặt các biến này trong phần Environment của nền tảng hosting.

# Cổng chạy server (hosting thường tự cấp, local mặc định 5000)
PORT=5000

# Khi deploy: NODE_ENV=production (ẩn chi tiết lỗi) và TRUST_PROXY=1 (đang chạy sau reverse proxy).
# Chạy local thì để trống TRUST_PROXY.
# NODE_ENV=production
# TRUST_PROXY=1

# Đường dẫn file SQLite. Khi deploy phải trỏ vào ổ đĩa bền vững (persistent disk/volume),
# ví dụ /data/database.sqlite, nếu không dữ liệu sẽ mất sau mỗi lần deploy lại.
# DB_PATH=/data/database.sqlite

# Tài khoản admin đầu tiên - chỉ dùng khi bảng quan_tri_vien còn trống.
# Mật khẩu tối thiểu 8 ký tự. Sau khi đăng nhập, hãy đổi mật khẩu trong tab "Thanh toán & QR".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay-truoc-khi-dung

# Khóa ký phiên đăng nhập admin: chuỗi ngẫu nhiên dài, ví dụ tạo bằng
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
